"Ananasjuice",
"Sprite"
]
},

gintonic: {
navn: "🍸 Gin & Tonic",
ingredienser: [
"Gin",
"Tonic"
]
},

daiquiri: {
navn: "🍍 Pineapple Daiquiri",
ingredienser: [
"Rom",
"Ananasjuice",
"Lime"
]
}

};

function statusKnapper(id){

return `

<div class="statusknapper">

<button onclick="gemStatus('${id}','⭐ Vil prøve')">
⭐ Vil prøve
</button>

<button onclick="gemStatus('${id}','🍹 Smagt')">
🍹 Smagt
</button>

<button onclick="gemStatus('${id}','✅ Lavet selv')">
✅ Lavet selv
</button>

<button onclick="gemStatus('${id}','❤️ Favorit')">
❤️ Favorit
</button>

<button onclick="gemStatus('${id}','🚫 Kan ikke lide')">
🚫 Kan ikke lide
</button>

</div>

`;

}

function gemStatus(id,status){

localStorage.setItem(

"cocktail_" + id,

status

);

alert("Status gemt: " + status);

}

