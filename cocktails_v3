<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Claras Cocktail App</title>

<style>

body{
    font-family:Arial,sans-serif;
    margin:0;
    background:#f6f1ff;
}

header{
    background:#7c3aed;
    color:white;
    padding:20px;
}

.menu{
    margin-top:15px;
}

.menu a,
.menu span{
    display:inline-block;
    padding:10px 14px;
    border-radius:10px;
    text-decoration:none;
    font-weight:bold;
    margin-right:10px;
}

.menu a{
    background:white;
    color:#7c3aed;
}

.aktiv{
    background:#5b21b6;
    color:white;
}

.indhold{
    padding:20px;
}

#soegning{
    width:100%;
    box-sizing:border-box;
    padding:12px;
    border-radius:10px;
    border:1px solid #ccc;
    margin-bottom:20px;
}

.kort{
    background:white;
    padding:15px;
    border-radius:12px;
    margin-bottom:12px;
    cursor:pointer;
}

.kort:hover{
    background:#ece1ff;
}

#opskriftSide{
    display:none;
}

.opskriftKort{
    background:white;
    border-radius:12px;
    padding:20px;
}

.tilbage{
    padding:10px 15px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    margin-bottom:20px;
}

.statusknapper button{
    margin:5px;
    padding:10px;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

</style>

</head>

<body>

<header>

<h1>🍹 Claras Cocktail App</h1>

<div class="menu">
<a href="index.html">📦 Lager</a>
<span class="aktiv">🍹 Cocktails</span>
</div>

</header>

<div class="indhold">

<div id="listeSide">

<input
id="soegning"
type="text"
placeholder="Søg cocktail..."
>

<div class="kort" data-navn="aperol spritz" onclick="visOpskrift('aperol')">
<h3>🍹 Aperol Spritz</h3>
<p>Frugtig cocktail</p>
</div>

<div class="kort" data-navn="strawberry soda gin" onclick="visOpskrift('strawberry')">
<h3>🍓 Strawberry Soda Gin</h3>
<p>Sød cocktail</p>
</div>

<div class="kort" data-navn="espresso martini" onclick="visOpskrift('espresso')">
<h3>☕ Espresso Martini</h3>
<p>Kaffecocktail</p>
</div>

<div class="kort" data-navn="ananas cooler" onclick="visOpskrift('cooler')">
<h3>🍍 Ananas Cooler</h3>
<p>Mocktail</p>
</div>

<div class="kort" data-navn="pineapple daiquiri" onclick="visOpskrift('daiquiri')">
<h3>🍍 Pineapple Daiquiri</h3>
<p>Rom og ananas</p>
</div>

</div>

<div id="opskriftSide">

<div class="opskriftKort" id="opskriftIndhold">

</div>

</div>
