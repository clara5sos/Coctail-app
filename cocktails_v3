<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Claras Cocktail App</title>

<style>

body{
    font-family:Arial,sans-serif;
    margin:0;
    background:#f6f1ff;
}

header{
    background:#7c3aed;
    color:white;
    padding:20px;
}

.menu{
    margin-top:15px;
}

.menu a,
.menu span{
    display:inline-block;
    padding:10px 14px;
    border-radius:10px;
    text-decoration:none;
    font-weight:bold;
    margin-right:10px;
}

.menu a{
    background:white;
    color:#7c3aed;
}

.aktiv{
    background:#5b21b6;
    color:white;
}

.indhold{
    padding:20px;
}

#soegning{
    width:100%;
    box-sizing:border-box;
    padding:12px;
    border-radius:10px;
    border:1px solid #ccc;
    margin-bottom:20px;
}

.kort{
    background:white;
    padding:15px;
    border-radius:12px;
    margin-bottom:12px;
    cursor:pointer;
}

.kort:hover{
    background:#ece1ff;
}

#opskriftSide{
    display:none;
}

.opskriftKort{
    background:white;
    border-radius:12px;
    padding:20px;
}

.tilbage{
    padding:10px 15px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    margin-bottom:20px;
}

.statusknapper button{
    margin:5px;
    padding:10px;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

</style>

</head>

<body>

<header>

<h1>🍹 Claras Cocktail App</h1>

<div class="menu">
<a href="index.html">📦 Lager</a>
<span class="aktiv">🍹 Cocktails</span>
</div>

</header>

<div class="indhold">

<div id="listeSide">

<input
id="soegning"
type="text"
placeholder="Søg cocktail..."
>

<div class="kort" data-navn="aperol spritz" onclick="visOpskrift('aperol')">
<h3>🍹 Aperol Spritz</h3>
<p>Frugtig cocktail</p>
</div>

<div class="kort" data-navn="strawberry soda gin" onclick="visOpskrift('strawberry')">
<h3>🍓 Strawberry Soda Gin</h3>
<p>Sød cocktail</p>
</div>

<div class="kort" data-navn="espresso martini" onclick="visOpskrift('espresso')">
<h3>☕ Espresso Martini</h3>
<p>Kaffecocktail</p>
</div>

<div class="kort" data-navn="ananas cooler" onclick="visOpskrift('cooler')">
<h3>🍍 Ananas Cooler</h3>
<p>Mocktail</p>
</div>

<div class="kort" data-navn="pineapple daiquiri" onclick="visOpskrift('daiquiri')">
<h3>🍍 Pineapple Daiquiri</h3>
<p>Rom og ananas</p>
</div>

</div>

<div id="opskriftSide">

<div class="opskriftKort" id="opskriftIndhold">

</div>

</div>
<script>

const opskrifter = {

aperol: {
navn: "🍹 Aperol Spritz",
ingredienser: [
"Aperol",
"Prosecco",
"Danskvand"
]
},

strawberry: {
navn: "🍓 Strawberry Soda Gin",
ingredienser: [
"Gin",
"Jordbærsodavand"
]
},

espresso: {
navn: "☕ Espresso Martini",
ingredienser: [
"Vodka",
"Kaffelikør",
"Espresso"
]
},

cooler: {
navn: "🍍 Ananas Cooler",
ingredienser: [
"Ananasjuice",
"Sprite"
]
},

daiquiri: {
navn: "🍍 Pineapple Daiquiri",
ingredienser: [
"Rom",
"Ananasjuice",
"Lime"
]
}

};

function gemStatus(id,status){

localStorage.setItem(
"cocktail_"+id,
status
);

alert("Status gemt: " + status);

}

function statusKnapper(id){

return `
<div class="statusknapper">

<button onclick="gemStatus('${id}','⭐ Vil prøve')">
⭐ Vil prøve
</button>

<button onclick="gemStatus('${id}','🍹 Smagt')">
🍹 Smagt
</button>

<button onclick="gemStatus('${id}','✅ Lavet selv')">
✅ Lavet selv
</button>

<button onclick="gemStatus('${id}','❤️ Favorit')">
❤️ Favorit
</button>

<button onclick="gemStatus('${id}','🚫 Kan ikke lide')">
🚫 Kan ikke lide
</button>

</div>
`;

}

function visOpskrift(id){

const data = opskrifter[id];

document.getElementById("listeSide")
.style.display = "none";

document.getElementById("opskriftSide")
.style.display = "block";

const ingrediensListe =
data.ingredienser
.map(item => "<li>" + item + "</li>")
.join("");

document.getElementById("opskriftIndhold")
.innerHTML =
`

<button class="tilbage" onclick="lukOpskrift()">
← Tilbage til cocktails
</button>

<h2>${data.navn}</h2>

<h3>Ingredienser</h3>

<ul>
${ingrediensListe}
</ul>

<h3>Status</h3>

${statusKnapper(id)}

`;

window.scrollTo({
top:0,
behavior:"smooth"
});

}

function lukOpskrift(){

document.getElementById("opskriftSide")
.style.display = "none";

document.getElementById("listeSide")
.style.display = "block";

window.scrollTo({
top:0,
behavior:"smooth"
});

}

document
.getElementById("soegning")
.addEventListener("input",function(){

const tekst =
this.value.toLowerCase();

document
.querySelectorAll(".kort")
.forEach(kort=>{

if(
kort.dataset.navn
.includes(tekst)
){
kort.style.display = "block";
}
else{
kort.style.display = "none";
}

});

});

</script>

</body>
</html>