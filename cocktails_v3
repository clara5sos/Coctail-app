<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Claras Cocktail App - Cocktails</title>

<style>

body{
    font-family: Arial, sans-serif;
    background:#f6f1ff;
    margin:0;
}

header{
    background:#7c3aed;
    color:white;
    padding:20px;
}

h1{
    margin:0;
}

.menu{
    margin-top:15px;
}

.menu a,
.menu span{
    display:inline-block;
    text-decoration:none;
    margin-right:10px;
    padding:10px 14px;
    border-radius:10px;
    font-weight:bold;
}

.menu a{
    background:white;
    color:#7c3aed;
}

.aktiv{
    background:#5b21b6;
    color:white;
}

.indhold{
    padding:20px;
}

#listeSide{
    display:block;
}

#opskriftSide{
    display:none;
}

#soegning{
    width:100%;
    padding:12px;
    border-radius:10px;
    border:1px solid #ccc;
    margin-bottom:20px;
    box-sizing:border-box;
}

.kort{
    background:white;
    border-radius:12px;
    padding:15px;
    margin-bottom:15px;
    cursor:pointer;
}

.kort:hover{
    background:#ece1ff;
}

.opskriftKort{
    background:white;
    border-radius:12px;
    padding:20px;
}

.tilbage{
    padding:10px 15px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    margin-bottom:20px;
}

.statusknapper{
    margin-top:20px;
}

.statusknapper button{
    margin:5px;
    padding:10px;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

h2{
    margin-top:0;
}

</style>

</head>

<body>

<header>

<h1>🍹 Claras Cocktail App</h1>

<div class="menu">
<a href="index.html">📦 Lager</a>
<span class="aktiv">🍹 Cocktails</span>
</div>

</header>

<div class="indhold">

<div id="listeSide">

<input
type="text"
id="soegning"
placeholder="Søg cocktail..."
>

<div class="kort" data-navn="aperol spritz" onclick="visOpskrift('aperol')">
<h3>🍹 Aperol Spritz</h3>
<p>Frugtig cocktail med Aperol</p>
</div>

<div class="kort" data-navn="strawberry soda gin" onclick="visOpskrift('strawberry')">
<h3>🍓 Strawberry Soda Gin</h3>
<p>Sød jordbærcocktail</p>
</div>

<div class="kort" data-navn="espresso martini" onclick="visOpskrift('espresso')">
<h3>☕ Espresso Martini</h3>
<p>Cocktail med kaffe</p>
</div>

<div class="kort" data-navn="ananas cooler" onclick="visOpskrift('cooler')">
<h3>🍍 Ananas Cooler</h3>
<p>Mocktail</p>
</div>

<div class="kort" data-navn="gin tonic" onclick="visOpskrift('gintonic')">
<h3>🍸 Gin & Tonic</h3>
<p>Klassisk cocktail</p>
</div>

<div class="kort" data-navn="pineapple daiquiri" onclick="visOpskrift('daiquiri')">
<h3>🍍 Pineapple Daiquiri</h3>
<p>Sød romcocktail</p>
</div>

</div>

<div id="opskriftSide">

<div class="opskriftKort" id="opskriftIndhold">

</div>

</div>
<script>

